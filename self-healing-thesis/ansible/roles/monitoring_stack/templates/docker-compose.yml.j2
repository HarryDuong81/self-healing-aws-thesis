version: "3.8"

# =============================================================================
# Self-Healing Thesis — Monitoring Stack
# Generated by Ansible role: monitoring_stack
# =============================================================================

networks:
  monitoring:
    driver: bridge

volumes:
  prometheus_data:
  grafana_data:
  elasticsearch_data:
  jaeger_data:

services:

  # ── Prometheus ───────────────────────────────────────────────────────────────
  prometheus:
    image: prom/prometheus:v{{ prometheus_version }}
    container_name: prometheus
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 108.8 MiB against the previous 512m limit — reclaimed to fund
    # headroom for Logstash/Elasticsearch/Kibana, which were pinned at
    # their own limits and OOM-crash-looping host-wide (CLAUDE.md §15.8).
    mem_limit: 160m
    ports:
      - "{{ prometheus_port }}:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d"
      - "--web.enable-lifecycle"
      - "--web.enable-admin-api"
    networks:
      - monitoring
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9090/-/ready"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Alertmanager ──────────────────────────────────────────────────────────────
  alertmanager:
    image: prom/alertmanager:v{{ alertmanager_version }}
    container_name: alertmanager
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 22.9 MiB against the previous 128m limit — reclaimed (§15.8).
    mem_limit: 48m
    network_mode: host
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
      - "--web.listen-address=:{{ alertmanager_port }}"
      # Alertmanager's default cluster/gossip listener binds 0.0.0.0:9094 —
      # the exact same port as the orchestrator's Flask app (Thesis Table
      # 4.3), and because this container runs network_mode: host, that
      # collides directly with the already-running systemd orchestrator.
      # Confirmed live: "bind: address already in use" crash-looping the
      # container. This is a single-node deployment with no peer
      # Alertmanager instances, so disable clustering entirely rather than
      # relocate it to a different port.
      - "--cluster.listen-address="
    # NOTE: network_mode=host lets Alertmanager reach the systemd-managed
    # orchestrator directly via the host's private IP on port
    # {{ orchestrator_port }} (see alertmanager.yml.j2's webhook_configs).
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:{{ alertmanager_port }}/-/ready"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Grafana ───────────────────────────────────────────────────────────────────
  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): confirmed live via dmesg
    # that Grafana was being OOM-killed repeatedly at the previous 256m
    # limit (§15.8). Modest bump, not full parity with the JVM services.
    mem_limit: 288m
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring
    depends_on:
      - prometheus
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Elasticsearch ─────────────────────────────────────────────────────────────
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:{{ elasticsearch_version }}
    container_name: elasticsearch
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 905.6 MiB against the previous 1g limit (11% headroom) — confirmed
    # live as one of the two primary victims of a host-wide OOM crash-loop
    # (§15.8). ES_JAVA_OPTS heap (512m) unchanged; only the container
    # ceiling is raised.
    mem_limit: 1280m
    ports:
      - "{{ elasticsearch_port }}:9200"
    environment:
      discovery.type: single-node
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms512m -Xmx512m"
      cluster.name: self-healing-cluster
    volumes:
      - elasticsearch_data:/usr/share/elasticsearch/data
    networks:
      - monitoring
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9200/_cluster/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Logstash ──────────────────────────────────────────────────────────────────
  logstash:
    image: docker.elastic.co/logstash/logstash:{{ logstash_version }}
    container_name: logstash
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 511.6 MiB — essentially AT the previous 512m limit. Confirmed live
    # (docker inspect RestartCount=21, dmesg) as the primary victim of a
    # continuous host-wide OOM crash-loop running since near host boot
    # (CLAUDE.md §15.8). LS_JAVA_OPTS heap (256m) unchanged; only the
    # container ceiling is raised to give JVM/JRuby non-heap overhead room.
    mem_limit: 768m
    ports:
      - "{{ logstash_beats_port }}:5044"
    volumes:
      - ./elk/logstash/pipeline:/usr/share/logstash/pipeline:ro
    environment:
      LS_JAVA_OPTS: "-Xms256m -Xmx256m"
      xpack.monitoring.enabled: "false"
    networks:
      - monitoring
    depends_on:
      elasticsearch:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Kibana ────────────────────────────────────────────────────────────────────
  kibana:
    image: docker.elastic.co/kibana/kibana:{{ kibana_version }}
    container_name: kibana
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 492.2 MiB, nearly at the previous 512m limit, contributing to the
    # host-wide OOM crash-loop (CLAUDE.md §15.8). See the NODE_OPTIONS
    # comment below for why this limit, not the JS heap cap, was binding.
    # Raised again 2026-09-29: confirmed live via a redeploy's own crash
    # log that the 500m heap cap was still hit during startup plugin
    # loading (V8 Mark-Compact oscillating 476-505 MiB right at the
    # ceiling before FATAL ERROR). 850m keeps the same ~150m headroom
    # above the new 700m heap cap below.
    mem_limit: 850m
    ports:
      - "{{ kibana_port }}:5601"
    environment:
      ELASTICSEARCH_HOSTS: "http://elasticsearch:9200"
      xpack.security.enabled: "false"
      # Node/V8 sizes its default heap off the HOST's perceived total memory,
      # not this container's 512m cgroup limit - confirmed live: Kibana
      # crash-looped with "FATAL ERROR: JavaScript heap out of memory" on
      # every startup attempt on the t3.medium monitoring host, even though
      # docker stats showed it using only ~290MiB (56%) of its own 512m
      # limit at the moment it died. Elasticsearch/Logstash don't have this
      # problem because ES_JAVA_OPTS/LS_JAVA_OPTS already bound their JVM
      # heaps explicitly below their container limits; Kibana had no
      # equivalent cap. Deployment-session correction (2026-09-22, same day
      # as the 608m container-limit raise, CLAUDE.md §15.8): 400 was still
      # too tight for Kibana's own *startup-time* working set -- confirmed
      # live via a genuine V8 "FATAL ERROR: JavaScript heap out of memory"
      # crash (docker inspect OOMKilled=false -- this is V8's own heap
      # ceiling, not the kernel cgroup OOM killer that hit Logstash/
      # Elasticsearch/Grafana) even after the container mem_limit was
      # raised, because --max-old-space-size is a Node-level cap
      # independent of the cgroup limit around it. RQ3's own steady-state
      # data (p95 492.2 MiB / max 492.7 MiB total container RSS) shows
      # Kibana comfortably fits once running -- this was a startup spike,
      # not a steady-state sizing problem.
      # Raised 500->700 on 2026-09-29: 500m was still not enough for a
      # genuine redeploy's startup plugin-loading spike (confirmed live,
      # see the mem_limit comment above) -- 108m of headroom wasn't the
      # binding constraint, the cap itself was. 700m leaves ~150m of
      # headroom under the 850m container limit for non-heap V8/Node
      # overhead. If this still crash-loops, the next lever is trimming
      # Kibana's default ~185-plugin startup set via kibana.yml
      # (candidate fix already named in CLAUDE.md §15.8, not yet tried),
      # not another heap-cap increase.
      NODE_OPTIONS: "--max-old-space-size=700"
    volumes:
      - ./kibana/kibana.yml:/usr/share/kibana/config/kibana.yml:ro
    networks:
      - monitoring
    depends_on:
      elasticsearch:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── Jaeger (unified image — v2+ uses jaegertracing/jaeger, not all-in-one) ───
  # Thesis Table 4.3: jaegertracing/jaeger:2.18.0
  # The jaegertracing/jaeger image replaced jaegertracing/all-in-one from v2.x.
  jaeger:
    image: jaegertracing/jaeger:{{ jaeger_version }}
    container_name: jaeger
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state max was
    # 34.1 MiB against the previous 256m limit — reclaimed (§15.8).
    mem_limit: 48m
    ports:
      - "{{ jaeger_ui_port }}:16686"    # Jaeger UI
      - "14268:14268"                    # Jaeger HTTP collector (legacy, optional)
    environment:
      COLLECTOR_OTLP_ENABLED: "true"
      SPAN_STORAGE_TYPE: badger
      BADGER_EPHEMERAL: "false"
      BADGER_DIRECTORY_VALUE: /badger/data
      BADGER_DIRECTORY_KEY: /badger/key
    volumes:
      - jaeger_data:/badger
    networks:
      - monitoring
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:16686/"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # ── OpenTelemetry Collector ───────────────────────────────────────────────────
  # Thesis Table 4.3: otel/opentelemetry-collector:0.152.0
  # Receives OTLP traces from target instances (port 4317) and forwards to Jaeger.
  # Running as a sidecar alongside Jaeger so the two are independently upgradeable.
  otelcol:
    image: otel/opentelemetry-collector:{{ otel_collector_version }}
    container_name: otelcol
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 31.5 MiB against the previous 128m limit — reclaimed (§15.8).
    mem_limit: 56m
    command: ["--config=/etc/otelcol/config.yaml"]
    ports:
      - "{{ jaeger_otlp_grpc_port }}:4317"   # OTLP gRPC ingest from targets
    volumes:
      - ./otelcol/config.yaml:/etc/otelcol/config.yaml:ro
    networks:
      - monitoring
    depends_on:
      - jaeger
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "2"

  # NOTE: The Flask Orchestrator (Thesis Table 4.3, Listing 4.9: port 9094)
  # used to be defined here as a container built from {{ orchestrator_base_dir }},
  # duplicating the orchestrator already deployed as a systemd service by
  # roles/self_healing — both bound to the same host port 9094, which
  # would conflict the moment both were brought up. Removed in favor of the
  # systemd deployment described above. Alertmanager's webhook now reaches the
  # systemd orchestrator via the host's private IP instead of a container
  # hostname — see alertmanager.yml.j2.

  # ── cAdvisor (container resource metrics for RQ3) ─────────────────────────────
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v{{ cadvisor_version }}
    container_name: cadvisor
    restart: unless-stopped
    # Deployment-session rebalance (2026-09-22): RQ3 steady-state p95 was
    # 53.3 MiB against the previous 128m limit — reclaimed (§15.8).
    mem_limit: 80m
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    privileged: true
    devices:
      - /dev/kmsg
    networks:
      - monitoring
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "2"
