{
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "13.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "table", "name": "Table", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "Self-Healing Infrastructure — MAPE-K Pipeline Monitoring (Thesis Chapter 4)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "System Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red",   "index": 0, "text": "DOWN"}},  "type": "value"},
            {"options": {"1": {"color": "green", "index": 1, "text": "UP"}},    "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",   "value": null},
            {"color": "green", "value": 1}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "text": {"titleSize": 16, "valueSize": 20}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "label_replace(node_systemd_unit_state{job=\"node_exporter\",name=\"nginx.service\",state=\"active\"}, \"target_short\", \"$1\", \"node_name\", \"self-healing-thesis-experiment-(.*)\")", "legendFormat": "{{target_short}}", "refId": "A"}
      ],
      "title": "NGINX Targets Up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red",   "index": 0, "text": "DOWN"}}, "type": "value"},
            {"options": {"1": {"color": "green", "index": 1, "text": "UP"}},   "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",   "value": null},
            {"color": "green", "value": 1}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "text": {"titleSize": 16, "valueSize": 20}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "label_replace(up{job=\"node_exporter\"}, \"target_short\", \"$1\", \"node_name\", \"self-healing-thesis-experiment-(.*)\")", "legendFormat": "{{target_short}}", "refId": "A"}
      ],
      "title": "Node Exporter Targets Up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red",   "value": 3}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "text": {"titleSize": 16, "valueSize": 20}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",fault_type=~\".+\"})", "legendFormat": "Active Faults", "refId": "A"}
      ],
      "title": "Active Fault Alerts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Resource Utilisation",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green",  "value": null},
            {"color": "orange", "value": 75},
            {"color": "red",    "value": 85}
          ]},
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 10,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 - (avg by (node_name) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{node_name}} CPU %",
          "refId": "A"
        }
      ],
      "title": "CPU Utilisation (fault threshold: 85%)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green",  "value": null},
            {"color": "orange", "value": 15},
            {"color": "red",    "value": 10}
          ]},
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 11,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "{{node_name}} MemAvailable %",
          "refId": "A"
        }
      ],
      "title": "Memory Available % (fault threshold: <10%)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green",  "value": null},
            {"color": "orange", "value": 80},
            {"color": "red",    "value": 90}
          ]},
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 12,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100)",
          "legendFormat": "{{node_name}} Disk Used %",
          "refId": "A"
        }
      ],
      "title": "Disk Used % (fault threshold: >90%)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 102,
      "title": "MTTR — Aggregate (Prometheus)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "End-to-end T_MTTR only (mttr_seconds Histogram, orchestrator/app.py). Prometheus has no per-phase breakdown — orchestrator/app.py only calls MTTR_HISTOGRAM.observe() once per successful trial with the total elapsed time (fault_type/actuator labels only, no target label, no phase label). Full phase decomposition (T_detect/T_classify/T_remediate/T_observability_restore/T_validate) per trial_id lives only in results/mttr_log.jsonl on the monitoring host — not exported here. This panel previously queried a self_healing_mttr_seconds{phase=...} series that never existed in the codebase and always returned no data; corrected to the real metric name/labels.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2},
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green",  "value": null},
            {"color": "orange", "value": 180},
            {"color": "red",    "value": 300}
          ]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
      "id": 20,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(mttr_seconds_sum[15m]) / rate(mttr_seconds_count[15m])",
          "legendFormat": "T_MTTR avg (15m) {{fault_type}}/{{actuator}}",
          "refId": "A"
        }
      ],
      "title": "T_MTTR — 15m Rolling Average by Fault Class (SLO = 300 s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31},
      "id": 103,
      "title": "Active Alerts",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "alertname"}, "properties": [{"id": "custom.width", "value": 200}]},
          {"matcher": {"id": "byName", "options": "fault_type"},  "properties": [{"id": "custom.width", "value": 160}]},
          {"matcher": {"id": "byName", "options": "node_name"},   "properties": [{"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "alertstate"},  "properties": [
            {"id": "custom.width", "value": 80},
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
          ]}
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
      "id": 30,
      "options": {"showHeader": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ALERTS{fault_type=~\".+\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Fault-Class Alerts (firing)",
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "columns"}},
        {"id": "filterFieldsByName", "options": {"include": {"names": ["alertname", "fault_type", "node_name", "severity", "alertstate", "Value"]}}}
      ],
      "type": "table"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["self-healing", "thesis", "mape-k"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Self-Healing Infrastructure",
  "uid": "self-healing-main",
  "version": 1
}
