# backend.hcl — Terraform S3 backend for the UNIFIED state
# Generated by Ansible self_healing role — do not edit manually.
# Supplied to: terraform init -backend-config=backend.hcl
#
# Workflow v3: single unified state manages all infrastructure.
# The orchestrator's `terraform apply -target` operations use this same
# state file — no separate remediation state.
#
#   State file: s3://{{ s3_bucket_name }}/experiment/terraform.tfstate
#
# Terraform lock table: {{ project }}-{{ deploy_environment }}-tf-locks

bucket         = "{{ s3_bucket_name }}"
key            = "{{ deploy_environment }}/terraform.tfstate"
region         = "{{ aws_region }}"
dynamodb_table = "{{ project }}-{{ deploy_environment }}-tf-locks"
encrypt        = true
