[Unit]
Description=Self-Healing Flask Orchestrator
Documentation=https://github.com/self-healing-thesis
After=network.target monitoring-stack.service
Wants=monitoring-stack.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory={{ orchestrator_src }}
EnvironmentFile=/etc/orchestrator/orchestrator.env
ExecStart={{ orchestrator_venv }}/bin/gunicorn \
    --workers 1 \
    --worker-class sync \
    --timeout ${GUNICORN_TIMEOUT} \
    --bind 0.0.0.0:{{ orchestrator_port }} \
    --access-logfile {{ orchestrator_logs }}/access.log \
    --error-logfile {{ orchestrator_logs }}/error.log \
    --log-level info \
    app:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orchestrator

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
