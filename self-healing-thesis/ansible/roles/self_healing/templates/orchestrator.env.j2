# /etc/orchestrator/orchestrator.env
# Generated by Ansible — do not edit manually.
# Variable names must match orchestrator/execute.py exactly.

# Flask / Gunicorn
# Port 9094 — Thesis Table 4.3. Do NOT change to 5000.
FLASK_APP=app
FLASK_ENV=production
ORCHESTRATOR_PORT={{ orchestrator_port }}

# AWS
AWS_DEFAULT_REGION={{ aws_region }}

# System under test label (S1 = self-healing pipeline)
SYSTEM_UNDER_TEST={{ system_under_test | default('S1') }}

# Target instance IDs (space-separated, resolved at Ansible deploy time)
TARGET_INSTANCE_IDS={% for host in groups['target_nodes'] %}{{ hostvars[host]['ec2_instance_id'] | default('') }}{% if not loop.last %} {% endif %}{% endfor %}


# Target private IPs (comma-separated, for health checks)
# ec2_private_ip, not ansible_host — see MONITORING_SERVER_IP note above.
TARGET_IPS={% for host in groups['target_nodes'] %}{{ hostvars[host]['ec2_private_ip'] }}{% if not loop.last %},{% endif %}{% endfor %}


# S3 bucket for results upload and SSM command payloads
SSM_BUCKET={{ lookup('env', 'SSM_BUCKET') | default('REPLACE_S3_BUCKET', true) }}
S3_BUCKET={{ lookup('env', 'SSM_BUCKET') | default('REPLACE_S3_BUCKET', true) }}

# Monitoring server private IP
# Uses ec2_private_ip (aws_ec2.yml compose var), not ansible_host: confirmed
# live that ansible_host is absent from this host's hostvars entirely despite
# being set via the same `compose: ansible_host: private_ip_address` block —
# ec2_private_ip (compose: private_ip_address, same source) is present and
# correct where ansible_host was not.
MONITORING_SERVER_IP={{ hostvars[groups['monitoring_host'][0]]['ec2_private_ip'] }}

# Results directory
RESULTS_DIR={{ orchestrator_results }}

# ── Paths consumed by orchestrator/execute.py ─────────────────────────────────
# These names must match the os.environ.get() keys in execute.py exactly.
ANSIBLE_PLAYBOOK_DIR={{ orchestrator_base_dir }}/ansible/playbooks
ANSIBLE_INVENTORY={{ orchestrator_base_dir }}/ansible/inventory/aws_ec2.yml
ANSIBLE_CFG={{ orchestrator_base_dir }}/ansible/ansible.cfg
TERRAFORM_TARGETS_DIR={{ orchestrator_base_dir }}/terraform/targets

# ── Canonical Validate-phase health check (orchestrator/health_checker.py) ───
# Thesis Ch3 §3.7.2 — polls the Prometheus ALERTS series for t_clear.
PROMETHEUS_URL=http://localhost:9090

# ── Diagnostic-agent forwarding check (orchestrator/observability_checker.py) ─
# — confirms Filebeat is actually delivering documents to
# Elasticsearch after an instance_failure recreation, not just that the
# service is `active`.
ELASTICSEARCH_URL=http://localhost:9200

# ── DynamoDB stale-lock precondition (orchestrator/plan.py) ──────────────────
# Thesis Ch4 §4.2.2. Must match modules/storage's
# aws_dynamodb_table.lock name and the targets workspace's state bucket/key.
DYNAMODB_LOCK_TABLE={{ dynamodb_lock_table | default('REPLACE_DYNAMODB_TABLE', true) }}
# Confirmed live 2026-10-01: this previously read lookup('env', 'SSM_BUCKET'),
# which is the campaign DATA/results bucket (its-thesis-data-...), not the
# Terraform STATE bucket -- a wrong-variable bug, not a naming coincidence.
# dynamodb_lock_status()'s own lock_id is f"{bucket}/{key}", so every
# pre-check computed the wrong key and silently found "no lock" even when a
# real one was held -- confirmed via three separate orphaned locks this
# session, none of which this precondition ever caught; each one only
# surfaced downstream as a generic, hard-to-diagnose "terraform_error".
# bootstrap_state_bucket (role default, same value terraform/targets' own
# terraform.tfvars uses) is the correct, same constant for both purposes.
TF_STATE_BUCKET={{ bootstrap_state_bucket }}
TF_STATE_KEY=targets/terraform.tfstate

# ── Human escalation (orchestrator/app.py _escalate()) ───────────────────────
# — every terminal failure path (circuit_breaker_open,
# lease_held, transport_unreachable, out_of_scope_drift, retry_exhausted,
# validation_timeout, classification_error) must publish an SNS notification.
# Must match modules/monitoring's aws_sns_topic.alerts ARN.
SNS_TOPIC_ARN={{ sns_topic_arn | default('REPLACE_SNS_TOPIC_ARN', true) }}

# ── OpenTelemetry tracing → Jaeger ───────────────────────────────────────────
# google.protobuf's compiled _upb C-extension (pulled in transitively via
# opentelemetry-exporter-otlp-proto-grpc's protobuf==4.25.9 pin) is
# incompatible with the AMI's native Python 3.14.4 — confirmed live:
# "TypeError: Metaclasses with custom tp_new are not supported" on gunicorn
# worker boot, crash-looping the service (exit code 3). This is an upstream
# protobuf/CPython 3.13+ C-API compatibility gap, not an app bug. Force
# protobuf's pure-Python implementation instead of the C extension — the
# standard, documented workaround (a performance cost, not a correctness
# one) — rather than touching the requirements.txt version pins.
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
OTEL_SERVICE_NAME=self-healing-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:{{ jaeger_otlp_grpc_port }}
OTEL_RESOURCE_ATTRIBUTES=project={{ project }},environment={{ deploy_environment }}

# ── Gunicorn (single worker — serialises MTTR timestamps, Thesis §4.4.1) ─────
# GUNICORN_TIMEOUT is read by orchestrator.service.j2's ExecStart, so this
# file is the single source of truth for the deployed host; the Dockerfile
# carries its own copy for the container path and a unit test asserts the
# two agree. handle_alert() dispatches _run_mape_k() synchronously in the
# request handler, so this is a hard ceiling on per-alert MAPE-K duration
# and must exceed the worst-case SUM of every bounded wait one dispatch can
# make: 2460s for instance_failure (raised from 2280s when app.py's
# ObservabilityChecker forwarding-check window went 120s -> 300s,
# 2026-09-14), up to 1895s for the retry-equipped Ansible classes. The
# earlier 960s was below all six — it had been sized against the harness's
# 900s poll rather than against the dispatch itself.
# See orchestrator/app.py's module docstring for the derivation.
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=2700
GUNICORN_BIND=0.0.0.0:{{ orchestrator_port }}
