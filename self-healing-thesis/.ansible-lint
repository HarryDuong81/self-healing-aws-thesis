# .ansible-lint — lint profile for the self-healing artefact.
#
# WHY `min` AND NOT THE DEFAULT
#
# ansible-lint defaults to the `production` profile. Against this tree that
# yields 464 findings, of which 462 are stylistic:
#
#   214  fqcn[action-core]           command: -> ansible.builtin.command:
#    81  yaml[colons]                extra spaces after ':'
#    63  yaml[truthy]                yes/no -> true/false
#    32  var-naming[no-role-prefix]  role vars not prefixed with the role name
#    10  risky-shell-pipe            shell pipelines without pipefail
#   ~62  name casing, line length, file permissions, no-changed-when, ...
#
# Every one is a legitimate ansible-lint opinion, and adopting them is
# worthwhile eventually. But these playbooks are the instrument of a measured
# experimental campaign: they have been exercised end-to-end against live AWS
# infrastructure, and a ~450-item mechanical refactor of them immediately
# before the campaign trades a real risk of silent behavioural change for a
# cosmetic gain. `yes` -> `true` alone touches 63 lines across the remediation
# playbooks the MTTR measurements depend on.
#
# `min` enforces the rules tagged `unskippable` — syntax validity and module
# resolution. That is the property CI actually needs to guarantee: a playbook
# that cannot parse or references a module that is not installed will fail at
# remediation time, which would contaminate trial data. Style will not.
#
# Revisit after the campaign: raise to `basic`, then `safety`, fixing each
# tier in its own commit with the playbooks re-verified against staging.

profile: min

# ansible-lint resolves roles relative to the playbook directory unless it is
# told otherwise, so `ansible/playbooks/deploy.yml` importing `roles/common`
# reads as an unresolvable role. ansible/ansible.cfg already sets
# `roles_path = roles`; CI exports ANSIBLE_CONFIG so this file is honoured.
# Confirmed locally: without it, 2 spurious syntax-check[specific] failures;
# with it, both clear.
